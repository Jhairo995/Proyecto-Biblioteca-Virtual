# Copia este archivo como .env y cambia las claves antes de ejecutar: docker compose up --build
# Clave del usuario root de MariaDB (obligatoria)
DB_PASSWORD=cambia_esta_clave_de_bd
# Clave del administrador inicial admin@codelibrary.com (sin valor no se crea el administrador)
ADMIN_PASSWORD=cambia_esta_clave_de_admin
# Puerto del host donde se publica la app (opcional; por defecto 8081)
APP_PORT=8081
